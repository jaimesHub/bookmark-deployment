# ===== Docker image =====
DOCKER_USER=jaimes96
# Production: pin SHA cụ thể, vd: a1b2c3d
# Local dev: dùng latest cho tiện
APP_VERSION=latest

# ===== App config =====
APP_HOSTNAME=bookmark-local-dev    # Đổi thành tên VM khi deploy thật
SERVICE_NAME=bookmark-app
LOG_LEVEL=info                     # Sẽ map vào env API_LOG_LEVEL trong compose
APP_ENV=prod                       # Sẽ map vào env API_APP_ENV → bật JSON log structured (dev = console pretty)

# ===== Nginx =====
NGINX_HOST_PORT=80                  # Port public ra internet

# ===== Redis (KHÔNG password vì đây là learning project) =====
# Nếu thêm password sau này: uncomment + thêm vào docker-compose
# REDIS_PASSWORD=changeme
