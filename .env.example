# ===== Docker images =====
# Backend API image (build từ bookmark-management repo)
DOCKER_USER=jaimes96
# Production: pin SHA cụ thể, vd: 114e407- lấy git-sha vừa được build & push lên docker hub repository mới nhất (không phải latest tag)
# Local dev: dùng latest cho tiện
APP_VERSION=45944ce

# Frontend portal image (instructor-provided)
# Image: ebvn/bookmark-app-portal:mono — SolidStart SSR app
PORTAL_VERSION=mono

# ===== App config =====
APP_HOSTNAME=bookmark-local-dev    # Đổi thành tên VM khi deploy thật
SERVICE_NAME=bookmark-app
LOG_LEVEL=info                     # Sẽ map vào env API_LOG_LEVEL trong compose
APP_ENV=prod                       # Sẽ map vào env API_APP_ENV → bật JSON log structured (dev = console pretty)

# ===== Nginx =====
NGINX_HOST_PORT=80                  # Port public ra internet

# ===== Swagger =====
# Bật /swagger/index.html. PROD nên tắt (false) để tránh expose API docs ra public.
SWAGGER_ENABLED=true
# Empty = same-origin (recommended khi đi qua nginx). Override nếu có custom domain.
SWAGGER_HOST=

# ===== Redis (KHÔNG password vì đây là learning project) =====
# Nếu thêm password sau này: uncomment + thêm vào docker-compose
# REDIS_PASSWORD=changeme
